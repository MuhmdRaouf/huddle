#!/bin/sh
# huddle: starts the huddle binary — the CLI's words, the radar and kanban words, mcp, serve and
#   the hooks — downloading and verifying it on first use; huddle has no setup command.
#   sh "${CLAUDE_PLUGIN_ROOT}/dist/run" <command> [args...]
# huddle lives under ${AGENTS_HUDDLE_HOME:-$HOME/.agents/huddle-bin}/0.0.1; the first
# command downloads it from MuhmdRaouf/huddle's GitHub releases and verifies its sha256 there
# (HUDDLE_DOWNLOAD_BASE overrides the release URL for tests), waiting up to 120 s — 60 s for mcp,
# which Claude Code starts and waits for. Every verified install also points $home/current at the
# binary — the stable path a harness config names, good across upgrades. A hook never blocks or
# fails Claude Code: it exits 0 at once, starting one detached download — guarded by a lock in the
# version dir so every hook shares it — that installs the binary for the next hook.
# Generated by scripts/launcher.mjs; do not edit.
dir=$(dirname -- "$0")
command=$1
shift
case "$command" in
  cli) entry= ;;
  help) entry=help ;;
  -h) entry=-h ;;
  setup) entry=setup ;;
  up) entry=up ;;
  down) entry=down ;;
  server) entry=server ;;
  token) entry=token ;;
  members) entry=members ;;
  kick) entry=kick ;;
  open) entry=open ;;
  join) entry=join ;;
  whoami) entry=whoami ;;
  listen) entry=listen ;;
  map) entry=map ;;
  assign) entry=assign ;;
  brief) entry=brief ;;
  wait) entry=wait ;;
  wait-task) entry=wait-task ;;
  gate) entry=gate ;;
  ack) entry=ack ;;
  send) entry=send ;;
  reply) entry=reply ;;
  pub) entry=pub ;;
  doing) entry=doing ;;
  done) entry=done ;;
  blocked) entry=blocked ;;
  skipped) entry=skipped ;;
  todo) entry=todo ;;
  new) entry=new ;;
  start) entry=start ;;
  finish) entry=finish ;;
  depend) entry=depend ;;
  handoff) entry=handoff ;;
  ask) entry=ask ;;
  remember) entry=remember ;;
  verify) entry=verify ;;
  share) entry=share ;;
  knowledge) entry=knowledge ;;
  recall) entry=recall ;;
  kb) entry=kb ;;
  task) entry=task ;;
  pause) entry=pause ;;
  resume) entry=resume ;;
  pass) entry=pass ;;
  leave) entry=leave ;;
  ops) entry=ops ;;
  status) entry=status ;;
  mcp) entry=mcp ;;
  serve) entry=serve ;;
  hook) entry=hook ;;
  radar) entry=radar ;;
  kanban) entry=kanban ;;
  gateway) entry=gateway ;;
  *)
    echo "huddle: unknown command $command" >&2
    exit 2
    ;;
esac
hook=
[ "$entry" = hook ] && hook=1
detached=
for arg in "$@"; do
  [ "$arg" = hook ] && hook=1
  [ "$arg" = "--detached-fetch" ] && detached=1
done
os=$(uname -s)
case "$os" in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  *) os=unsupported ;;
esac
arch=$(uname -m)
case "$arch" in
  x86_64|amd64) arch=amd64 ;;
  arm64|aarch64) arch=arm64 ;;
  *) arch=unsupported ;;
esac
home=${AGENTS_HUDDLE_HOME:-$HOME/.agents/huddle-bin}
bin=$home/0.0.1/huddle
base=${HUDDLE_DOWNLOAD_BASE:-https://github.com/MuhmdRaouf/huddle/releases/download}
url=$base/v0.0.1/huddle-$os-$arch
want=
case "$os-$arch" in
  darwin-amd64) want=7af10d1953ed9546803c13b20e2c3f1c64463d723e53e4778e14e9a95545e7fe ;;
  darwin-arm64) want=affcbf03b7a365cdcaeb9d5bc79c817b5068c8afa39f649c71f7b250a5b8be1a ;;
  linux-amd64) want=a8cc2c2131339ea43af9436796a3155a50b31ae20fb899efcd181b20c3a0bb2e ;;
  linux-arm64) want=29afebc0c496de6c0407ac49f0d51fd1cc071d0021cc6aed469da40f14f3d035 ;;
esac

# download_huddle <timeout>: fetch the release asset, verify its sha256 and install it as $bin. Returns 0 when
# the binary is installed, 1 when the asset could not be fetched, 2 when it failed its checksum.
download_huddle() {
  timeout=$1
  mkdir -p "$home/0.0.1"
  tmp=$home/0.0.1/.huddle.$$.download
  got=
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --max-time "$timeout" -o "$tmp" "$url" && got=1
  elif command -v wget >/dev/null 2>&1; then
    wget -q -T "$timeout" -O "$tmp" "$url" && got=1
  fi
  if [ -z "$got" ]; then
    rm -f "$tmp"
    return 1
  fi
  sum=
  if command -v sha256sum >/dev/null 2>&1; then sum=$(sha256sum "$tmp")
  elif command -v shasum >/dev/null 2>&1; then sum=$(shasum -a 256 "$tmp")
  elif command -v openssl >/dev/null 2>&1; then sum=$(openssl dgst -sha256 -r "$tmp")
  fi
  if [ -n "$want" ] && [ "${sum%% *}" = "$want" ]; then
    chmod 755 "$tmp"
    mv -f "$tmp" "$bin"
    # $home/current names the installed binary for configs that must survive an upgrade: the link
    # is created beside $home and renamed over any old one, so a reader sees one path or the
    # other, never half of either. A machine without ln skips it — the resolved path is written
    # instead, as before this link existed.
    if command -v ln >/dev/null 2>&1; then
      ln -s "0.0.1/huddle" "$home/.current.$$" && mv -f "$home/.current.$$" "$home/current"
    fi
    return 0
  fi
  rm -f "$tmp"
  return 2
}

# fetch_under_lock: the download a detached fetch runs. The version dir's lock holds the fetcher's pid and
# start time ("<pid> <epoch seconds>"); another fetch exits while that pid lives and the lock is under 120 s
# old, and takes over a lock whose holder died or stalled, so one download serves every hook.
fetch_under_lock() {
  trap '' HUP
  mkdir -p "$home/0.0.1"
  lock=$home/0.0.1/.huddle.fetch.lock
  now=$(date +%s)
  if (set -C; echo "$$ $now" >"$lock") 2>/dev/null; then
    :
  else
    read pid when <"$lock" || :
    if [ -z "$pid" ]; then
      sleep 1
      read pid when <"$lock" || :
    fi
    case "$pid" in *[!0-9]*|"") pid=0 ;; esac
    case "$when" in *[!0-9]*|"") when=0 ;; esac
    if [ "$pid" -ne 0 ] && kill -0 "$pid" 2>/dev/null && [ $(( $(date +%s) - when )) -lt 120 ]; then
      return 0
    fi
    rm -f "$lock"
    (set -C; echo "$$ $now" >"$lock") 2>/dev/null || return 0
  fi
  if [ -x "$bin" ]; then
    rm -f "$lock"
    return 0
  fi
  download_huddle 120
  rm -f "$lock"
  return 0
}

if [ "$os" != unsupported ] && [ "$arch" != unsupported ]; then
  if [ -x "$bin" ]; then
    exec "$bin" ${entry:+"$entry"} "$@"
  fi
  if [ -n "$detached" ]; then
    fetch_under_lock
    exit 0
  fi
  if [ -n "$hook" ]; then
    # One detached download for every hook: it re-runs this script on $0 with --detached-fetch, so the fetch
    # reuses the same URL and checksum table; it ignores HUP and outlives the hook that started it.
    (
      trap '' HUP
      sh_cmd=$(command -v sh 2>/dev/null) || sh_cmd=/bin/sh
      exec "$sh_cmd" "$0" "$command" --detached-fetch
    ) >/dev/null 2>&1 </dev/null &
    exit 0
  fi
  timeout=120
  [ "$entry" = mcp ] && timeout=60
  download_huddle "$timeout"
  status=$?
  if [ "$status" = 0 ]; then
    exec "$bin" ${entry:+"$entry"} "$@"
  fi
  if [ "$status" = 2 ]; then
    echo "huddle: huddle download failed its checksum" >&2
  else
    echo "huddle: could not download huddle 0.0.1 ($url)" >&2
  fi
  code=127
  [ "$entry" = mcp ] && code=1
  exit $code
fi
[ -n "$hook" ] && exit 0
[ -n "$detached" ] && exit 0
echo "huddle: no huddle 0.0.1 binary for this platform ($os-$arch)" >&2
exit 127
