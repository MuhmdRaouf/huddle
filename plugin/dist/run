#!/bin/sh
# Gets the huddle binary for this OS and CPU, then runs it.
#   sh "${CLAUDE_PLUGIN_ROOT}/dist/run" <word> [args...]
# The word `setup` installs the binary: it downloads the release, or builds the checkout with
# cargo while no release is published. The word `update` asks GitHub for the latest published
# release and never builds: when that release is newer than the installed binary it downloads
# it, switches the link, hands the running router over and prints the version change. It exits 0
# for "nothing to update" and "GitHub unreachable", and leaves settings.json alone.
# Every other word runs the installed binary. A hook does nothing and exits 0 until
# /huddle:setup has installed a binary.
# HUDDLE_DOWNLOAD_BASE and HUDDLE_LATEST_URL move the release URLs for tests.

version=0.0.8
base=${HUDDLE_DOWNLOAD_BASE:-https://github.com/MuhmdRaouf/huddle/releases/download}
latest_url=${HUDDLE_LATEST_URL:-https://api.github.com/repos/MuhmdRaouf/huddle/releases/latest}
# A relative XDG or HUDDLE value is invalid and ignored, as the XDG Base Directory spec says.
absolute() {
  case "$1" in
    /*) printf '%s\n' "$1" ;;
  esac
}
data_home=$(absolute "${HUDDLE_DATA_HOME:-}")
if [ -z "$data_home" ]; then
  data_home=$(absolute "${XDG_DATA_HOME:-}")
  data_home=${data_home:-$HOME/.local/share}/huddle
fi
cache_home=$(absolute "${HUDDLE_CACHE_HOME:-}")
if [ -z "$cache_home" ]; then
  cache_home=$(absolute "${XDG_CACHE_HOME:-}")
  cache_home=${cache_home:-$HOME/.cache}/huddle
fi
bin_dir=$data_home/bin
link=$bin_dir/huddle
target=$bin_dir/huddle-$version
word=${1:-}

case "$word" in
  hook)
    [ -x "$link" ] && exec "$link" "$@"
    exit 0
    ;;
  setup | update)
    ;;
  run | status | result | cancel | add-dashboard-host | remove-dashboard-host | uninstall | router | provider | --version)
    [ -x "$link" ] && exec "$link" "$@"
    printf 'huddle: run /huddle:setup first\n' >&2
    exit 127
    ;;
  *)
    printf 'huddle: unknown command %s\n' "$word" >&2
    exit 2
    ;;
esac

case "$(uname -s)" in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  *) os=unsupported ;;
esac
case "$(uname -m)" in
  x86_64 | amd64) arch=amd64 ;;
  arm64 | aarch64) arch=arm64 ;;
  *) arch=unsupported ;;
esac
if [ "$os" = unsupported ] || [ "$arch" = unsupported ]; then
  printf 'huddle: no huddle %s binary for this platform (%s-%s)\n' "$version" "$os" "$arch" >&2
  exit 127
fi

asset=huddle-$os-$arch
url=$base/v$version/$asset
sums_url=$base/v$version/SHA256SUMS

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1"
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1"
  else
    return 1
  fi
}

# Folders get mode 0755 whatever the umask.
make_dir() {
  (umask 022 && mkdir -p "$1")
}

point_link() {
  ln -sf "huddle-$version" "$bin_dir/.huddle.$$.link" && mv -f "$bin_dir/.huddle.$$.link" "$link"
}

fail_download() {
  printf 'huddle: could not download huddle %s (%s)\n' "$version" "$url" >&2
  exit 127
}

# Darwin runs the system curl: it trusts the keychain where a PATH curl may not. HUDDLE_CURL
# pins the binary for tests.
pick_curl() {
  if [ -n "${HUDDLE_CURL:-}" ] && [ "$os" = darwin ]; then
    curl_bin=$HUDDLE_CURL
  elif [ "$os" = darwin ] && [ -x /usr/bin/curl ]; then
    curl_bin=/usr/bin/curl
  else
    curl_bin=curl
  fi
}

fetch_release() {
  pick_curl
  make_dir "$bin_dir" && make_dir "$cache_home" || fail_download
  tmp=$cache_home/.huddle.$$.download
  sums=$cache_home/.huddle.$$.sums
  # curl's own diagnostics stay off stderr: the failure message below names the URL.
  if ! "$curl_bin" -fsSL --max-time 120 -o "$tmp" "$url" 2>/dev/null ||
    ! "$curl_bin" -fsSL --max-time 30 -o "$sums" "$sums_url" 2>/dev/null; then
    rm -f "$tmp" "$sums"
    return 3
  fi
  want=
  while read -r sum name; do
    if [ "$name" = "$asset" ]; then
      want=$sum
      break
    fi
  done <"$sums"
  rm -f "$sums"
  if [ -z "$want" ]; then
    rm -f "$tmp"
    printf 'huddle: SHA256SUMS has no entry for %s\n' "$asset" >&2
    exit 127
  fi
  got=$(sha256_of "$tmp") || {
    rm -f "$tmp"
    printf 'huddle: neither sha256sum nor shasum is on PATH\n' >&2
    exit 127
  }
  got=${got%% *}
  if [ "$got" != "$want" ]; then
    rm -f "$tmp"
    printf 'huddle: huddle download failed its checksum\n' >&2
    exit 127
  fi
  # The rename into place stays inside bin_dir, so a reader never sees a half-copied binary.
  chmod 755 "$tmp" && mv -f "$tmp" "$bin_dir/.huddle.$$.landing" && mv -f "$bin_dir/.huddle.$$.landing" "$target"
  rm -f "$target.local"
}

find_source() {
  if [ -n "${HUDDLE_SOURCE:-}" ] && [ -f "$HUDDLE_SOURCE/crates/huddle/Cargo.toml" ]; then
    printf '%s\n' "$HUDDLE_SOURCE"
    return 0
  fi
  d=$(cd -- "$(dirname -- "$0")/../.." 2>/dev/null && pwd)
  if [ -n "$d" ] && [ -f "$d/crates/huddle/Cargo.toml" ]; then
    printf '%s\n' "$d"
    return 0
  fi
  m=${CLAUDE_CONFIG_DIR:-}
  [ -n "$m" ] || m=$HOME/.claude
  m=$m/plugins/marketplaces/muhmdraouf
  if [ -f "$m/crates/huddle/Cargo.toml" ]; then
    printf '%s\n' "$m"
    return 0
  fi
  return 1
}

build_local() {
  if ! command -v cargo >/dev/null 2>&1; then
    printf 'huddle: no huddle release is published; install Rust (cargo) to build it from the marketplace checkout\n' >&2
    printf 'huddle: could not download huddle %s (%s)\n' "$version" "$url" >&2
    exit 127
  fi
  root=$(find_source) || {
    printf 'huddle: no huddle checkout found to build from; set HUDDLE_SOURCE\n' >&2
    exit 1
  }
  make_dir "$bin_dir" && make_dir "$cache_home" || exit 1
  log=$cache_home/build.log
  if ! (cd "$root" && cargo build --release -p huddle) >"$log" 2>&1; then
    printf 'huddle: building huddle from %s failed; see %s\n' "$root" "$log" >&2
    exit 1
  fi
  tmp=$bin_dir/.huddle.$$.build
  cp "$root/target/release/huddle" "$tmp" && chmod 755 "$tmp" || exit 1
  if command -v codesign >/dev/null 2>&1; then
    codesign -s - -f -i huddle "$tmp" >/dev/null 2>&1 || true
  fi
  mv -f "$tmp" "$target" && : >"$target.local"
}

# The version of the router that answers on the port; empty when none does or it does not say.
router_version() {
  [ -x "$link" ] || return 0
  "$link" router status --json 2>/dev/null | sed -n 's/.*"version":"\([^"]*\)".*/\1/p'
}

router_running() {
  [ -x "$link" ] && "$link" router status --json >/dev/null 2>&1
}

# True when dotted number version $1 is newer than $2.
newer() {
  a=$1
  b=$2
  while [ -n "$a$b" ]; do
    a_part=${a%%.*}
    b_part=${b%%.*}
    [ "${a_part:-0}" -gt "${b_part:-0}" ] 2>/dev/null && return 0
    [ "${a_part:-0}" -lt "${b_part:-0}" ] 2>/dev/null && return 1
    case "$a" in *.*) a=${a#*.} ;; *) a= ;; esac
    case "$b" in *.*) b=${b#*.} ;; *) b= ;; esac
  done
  return 1
}

# The tag of the latest published release, without its leading v; empty when GitHub does not answer.
latest_published() {
  pick_curl
  "$curl_bin" -fsSL --max-time 15 -H 'Accept: application/vnd.github+json' "$latest_url" 2>/dev/null |
    sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"v\{0,1\}\([0-9][0-9.]*\)".*/\1/p' | sed -n 1p
}

from=
if [ "$word" = update ]; then
  plugin_version=$version
  if [ -L "$link" ]; then
    from=$(readlink "$link")
    from=${from#huddle-}
  fi
  running_version=$(router_version)
  latest=$(latest_published)
  if [ -z "$latest" ]; then
    printf 'huddle: could not check for updates (GitHub unreachable). You stay on %s.\n' "${from:-none}"
    exit 0
  fi
  if [ -z "$from" ] || newer "$latest" "$from"; then
    version=$latest
    target=$bin_dir/huddle-$version
    url=$base/v$version/$asset
    sums_url=$base/v$version/SHA256SUMS
  else
    version=$from
    target=$bin_dir/huddle-$version
    if [ -n "$running_version" ] && [ "$running_version" != "$version" ] && [ -x "$target" ]; then
      router_running && "$target" router start >/dev/null
      printf 'huddle %s → %s\n' "$running_version" "$version"
      exit 0
    fi
    printf 'huddle %s is the latest published version. Nothing to update.\n' "$version"
    exit 0
  fi
  [ -n "$from" ] || from=none
  was_running=0
  router_running && was_running=1
fi

# A local build carries no version, so its .local marker makes every setup try the release
# first, then rebuild. An update never builds.
if [ "$word" = update ]; then
  fetch_release || fail_download
elif [ ! -x "$target" ] || [ -e "$target.local" ]; then
  fetch_release
  status=$?
  if [ "$status" -ne 0 ]; then
    build_local
  fi
fi
point_link
if [ "$word" = update ]; then
  if [ "$was_running" = 1 ] && ! "$target" router start >/dev/null; then
    printf 'huddle: huddle %s is installed but the router did not hand over; run huddle router start\n' "$version" >&2
    exit 1
  fi
  printf 'huddle %s → %s\n' "$from" "$version"
  if newer "$version" "$plugin_version"; then
    printf 'Plugin is %s: run /plugin to update it too.\n' "$plugin_version"
  fi
  exit 0
fi
exec "$target" "$@"
