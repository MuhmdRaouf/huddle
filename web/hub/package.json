{
  "name": "@huddle/hub",
  "version": "0.0.1",
  "private": true,
  "description": "The hub dashboard: channels, tasks, messages and shared knowledge for AI coding sessions working as one team.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:static": "vp check",
    "format": "vp check --fix",
    "test": "vp test",
    "test:watch": "vp test watch",
    "coverage": "vp test run --coverage",
    "dist:fresh": "node scripts/build.mjs --check",
    "check": "npm run check:static && npm run coverage && npm run dist:fresh"
  },
  "dependencies": {
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.5",
    "daisyui": "5.7.47",
    "happy-dom": "20.14.5",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=22.3"
  }
}
