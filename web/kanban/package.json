{
  "name": "@huddle/kanban",
  "version": "0.0.1",
  "private": true,
  "description": "The kanban board's browser page: columns, cards, a ticket drawer and live updates over the board's own API.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:static": "vp check",
    "format": "vp check --fix",
    "test": "vp test",
    "check": "bun run check:static && bun run test && node scripts/build.mjs --check"
  },
  "dependencies": {
    "marked": "18.1.1",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "happy-dom": "20.14.5",
    "vite": "8.3.4",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=22.13"
  }
}
