  },
  "devDependencies": {
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "14.6.7",
    "@vitest/coverage-v8": "5.0.5",
    "happy-dom": "20.14.5",
    "preact": "11.0.1",
    "vite-plus": "1.3.0"
  },
  "peerDependencies": {
    "preact": "11.0.1"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=22.3"
  }
}
